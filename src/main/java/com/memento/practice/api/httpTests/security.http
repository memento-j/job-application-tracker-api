# Test routes are protected and users can only update their own applicaitons

### Logout of anything currently signedin
POST http://localhost:8080/api/v1/auth/logout


###
### Try to access protected routes (all return 403)
###

# get all of the signed in user's applications
GET http://localhost:8080/api/v1/applications

# get by id
GET http://localhost:8080/api/v1/applications/6

POST http://localhost:8080/api/v1/applications
Content-Type: application/json

{
    "jobTitle": "Developer",
	"jobSource": "LinkedIn",
	"dateApplied"  : "2026-01-01",
	"followupDate"  : "2026-01-08",
    "companyName" : "practimateai",
    "companyPage" : "practimateai.com",
    "hiringEmail" : "gaslightmyself@gmail.com",
    "hiringManagerName" : "Memento",
    "status" : "APPLIED",
    "interviewRound": 0
}

#update (put) by id
PUT http://localhost:8080/api/v1/applications/6
Content-Type: application/json

{
    "jobTitle": "Developer",
	"jobSource": "LinkedIn",
